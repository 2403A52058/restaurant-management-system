generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Roles Table
model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  permissions String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  users       User[]
  employees   Employee[]

  @@map("roles")
}

// 2. Users Table
model User {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee     Employee?
  invoices     Invoice[]

  @@index([roleId])
  @@map("users")
}

// 3. Employees Table
model Employee {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique @map("user_id")
  roleId    Int       @map("role_id")
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  phone     String    @db.VarChar(20)
  salary    Decimal   @db.Decimal(10, 2)
  hireDate  DateTime  @map("hire_date")
  status    String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, ON_LEAVE, TERMINATED
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  orders    Order[]

  @@index([roleId])
  @@map("employees")
}

// 4. Customers Table
model Customer {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(150)
  email         String?       @db.VarChar(150)
  phone         String        @db.VarChar(20)
  address       String?       @db.VarChar(255)
  loyaltyPoints Int           @default(0) @map("loyalty_points")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  reservations  Reservation[]
  orders        Order[]

  @@map("customers")
}

// 5. Categories Table
model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(255)
  imageUrl    String?    @map("image_url") @db.Text
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  menuItems   MenuItem[]

  @@map("categories")
}

// 6. Menu Items Table
model MenuItem {
  id              Int         @id @default(autoincrement())
  categoryId      Int         @map("category_id")
  name            String      @db.VarChar(150)
  description     String?     @db.Text
  price           Decimal     @db.Decimal(10, 2)
  costPrice       Decimal?    @map("cost_price") @db.Decimal(10, 2)
  imageUrl        String?     @map("image_url") @db.Text
  isAvailable     Boolean     @default(true) @map("is_available")
  preparationTime Int         @default(15) @map("preparation_time") // in minutes
  isVeg           Boolean     @default(false) @map("is_veg")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([categoryId])
  @@map("menu_items")
}

// 7. Restaurant Tables Table
model RestaurantTable {
  id              Int           @id @default(autoincrement())
  tableNumber     String        @unique @map("table_number") @db.VarChar(20)
  seatingCapacity Int           @map("seating_capacity")
  location        String?       @db.VarChar(100) // Main Hall, Patio, Rooftop, Private Lounge
  status          String        @default("AVAILABLE") @db.VarChar(30) // AVAILABLE, RESERVED, OCCUPIED
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  reservations    Reservation[]
  orders          Order[]

  @@map("restaurant_tables")
}

// 8. Reservations Table
model Reservation {
  id              Int             @id @default(autoincrement())
  customerId      Int             @map("customer_id")
  tableId         Int             @map("table_id")
  reservationDate DateTime        @map("reservation_date")
  timeSlot        String          @map("time_slot") @db.VarChar(50) // e.g. "19:00 - 21:00"
  guestCount      Int             @map("guest_count")
  status          String          @default("PENDING") @db.VarChar(30) // PENDING, CONFIRMED, CANCELLED, COMPLETED
  specialRequests String?         @map("special_requests") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tableId])
  @@map("reservations")
}

// 9. Orders Table
model Order {
  id             Int             @id @default(autoincrement())
  orderNumber    String          @unique @map("order_number") @db.VarChar(50)
  tableId        Int?            @map("table_id")
  customerId     Int?            @map("customer_id")
  employeeId     Int?            @map("employee_id")
  orderType      String          @default("DINE_IN") @map("order_type") @db.VarChar(30) // DINE_IN, TAKEAWAY, DELIVERY
  status         String          @default("PENDING") @db.VarChar(30) // PENDING, PREPARING, READY, SERVED, CANCELLED
  subtotal       Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee       Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  payments       Payment[]
  invoice        Invoice?

  @@index([tableId])
  @@index([customerId])
  @@index([employeeId])
  @@map("orders")
}

// 10. Order Items Table
model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  menuItemId Int      @map("menu_item_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?  @db.VarChar(255)
  status     String   @default("PENDING") @db.VarChar(30) // PENDING, PREPARING, READY, SERVED
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// 11. Payments Table
model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  paymentMethod String   @map("payment_method") @db.VarChar(30) // CASH, CARD, UPI
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("COMPLETED") @db.VarChar(30) // PENDING, COMPLETED, FAILED, REFUNDED
  transactionId String?  @map("transaction_id") @db.VarChar(100)
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// 12. Invoices Table
model Invoice {
  id             Int      @id @default(autoincrement())
  invoiceNumber  String   @unique @map("invoice_number") @db.VarChar(50)
  orderId        Int      @unique @map("order_id")
  customerName   String?  @map("customer_name") @db.VarChar(150)
  customerPhone  String?  @map("customer_phone") @db.VarChar(20)
  subtotal       Decimal  @db.Decimal(10, 2)
  taxRate        Decimal  @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
  paymentStatus  String   @default("PAID") @map("payment_status") @db.VarChar(30) // PAID, UNPAID, PARTIAL
  generatedBy    Int?     @map("generated_by") // user_id
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator        User?    @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  @@index([generatedBy])
  @@map("invoices")
}

// 13. Ingredients Table
model Ingredient {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique @db.VarChar(100)
  category     String                 @db.VarChar(50) // Produce, Dairy, Meat, Spices, Bakery, Beverages, Dry Goods
  currentStock Decimal                @default(0) @map("current_stock") @db.Decimal(10, 2)
  unit         String                 @db.VarChar(20) // kg, g, l, ml, pcs, packs
  minThreshold Decimal                @default(5.00) @map("min_threshold") @db.Decimal(10, 2)
  unitCost     Decimal                @default(0) @map("unit_cost") @db.Decimal(10, 2)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  @@map("ingredients")
}

// 14. Suppliers Table
model Supplier {
  id            Int                    @id @default(autoincrement())
  name          String                 @db.VarChar(150)
  contactPerson String?                @map("contact_person") @db.VarChar(100)
  email         String?                @db.VarChar(150)
  phone         String                 @db.VarChar(20)
  address       String?                @db.VarChar(255)
  suppliedItems String?                @map("supplied_items") @db.VarChar(255)
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  transactions  InventoryTransaction[]

  @@map("suppliers")
}

// 15. Inventory Transactions Table
model InventoryTransaction {
  id           Int        @id @default(autoincrement())
  ingredientId Int        @map("ingredient_id")
  supplierId   Int?       @map("supplier_id")
  type         String     @db.VarChar(30) // PURCHASE, USAGE, SPOILAGE, ADJUSTMENT
  quantity     Decimal    @db.Decimal(10, 2)
  unitCost     Decimal?   @map("unit_cost") @db.Decimal(10, 2)
  totalCost    Decimal?   @map("total_cost") @db.Decimal(10, 2)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([supplierId])
  @@map("inventory_transactions")
}

// Settings Table for Restaurant configuration
model RestaurantSetting {
  id             Int      @id @default(1)
  restaurantName String   @default("Le Petit Gourmet") @map("restaurant_name") @db.VarChar(150)
  tagline        String   @default("Exquisite Dining & Modern Bistro") @db.VarChar(255)
  address        String   @default("108 Royal Orchid Blvd, Gourmet District") @db.VarChar(255)
  phone          String   @default("+1 (555) 382-7491") @db.VarChar(30)
  email          String   @default("contact@lepetitgourmet.com") @db.VarChar(150)
  currencySymbol String   @default("$") @map("currency_symbol") @db.VarChar(10)
  currencyCode   String   @default("USD") @map("currency_code") @db.VarChar(10)
  defaultTaxRate Decimal  @default(5.00) @map("default_tax_rate") @db.Decimal(5, 2)
  openingHours   String   @default("11:00 AM - 11:00 PM") @map("opening_hours") @db.VarChar(100)
  invoiceFooter  String   @default("Thank you for dining with us! Please visit again.") @map("invoice_footer") @db.VarChar(255)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("restaurant_settings")
}
