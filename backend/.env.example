# ==============================================
# KodiKart Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Database (Supabase PostgreSQL - Free)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Server
PORT=5000
NODE_ENV=development

# JWT (generate a strong random secret - minimum 64 characters)
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# Email OTP via Resend.com (free - 3000 emails/month, no credit card)
# Sign up at https://resend.com
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_API_KEY"
FROM_EMAIL="noreply@yourdomain.com"
# In development: OTP is printed to console if RESEND_API_KEY is not set

# Razorpay Payment Gateway (optional - add after KYC approval)
# Sign up at https://razorpay.com - Individual / Proprietor KYC accepted
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_YOUR_KEY"
RAZORPAY_KEY_SECRET="REPLACE_WITH_YOUR_SECRET"

# Cloudinary File Uploads (free - 25 credits/month)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="REPLACE_WITH_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_WITH_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_API_SECRET"

# Admin Bootstrap
ADMIN_EMAIL="admin@kodikart.in"
ADMIN_PHONE="9999999999"
ADMIN_NAME="KodiKart Admin"

# CORS Origin (your frontend domain)
FRONTEND_URL="http://localhost:3000"
# Production: FRONTEND_URL="https://kodikart.pages.dev"
