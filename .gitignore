# ============================================================
# KodiKart — Git Ignore Rules
# NEVER commit secrets, credentials, or generated artifacts
# ============================================================

# ─── Node ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Environment / Secrets ──────────────────────────────────
# !!! NEVER commit these !!!
.env
.env.local
.env.production
.env.staging
.env.test
backend/.env
frontend/.env
**/secrets.*
*.pem
*.key
*.cert
*.p12
*.pfx

# ─── Build Outputs ──────────────────────────────────────────
dist/
build/
.cache/
frontend/dist/
frontend/build/
backend/dist/
.next/
.nuxt/
.output/

# ─── Database ───────────────────────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/migrations/
*.sqlite
*.sqlite3

# ─── Uploads / Temp ─────────────────────────────────────────
uploads/
temp/
tmp/
*.tmp

# ─── OS Generated ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor ───────────────────────────────────────────
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# ─── Testing ────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ───────────────────────────────────────────────────
*.tgz
*.tar.gz
.vercel
.netlify
